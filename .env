
# Базовый путь для Router

VITE_BASE_URL=/

# URL для API, например для будущих запросов
VITE_API_URL=https://api.liminal.tech

# Флаг для включения/выключения фичи Dashboard 
#false → только стабильный функционал для широкой аудитории.
#true  → показываешь «бета-фичи» VIP-клиентам
VITE_ENABLE_DASHBOARD=true
